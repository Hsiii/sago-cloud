#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: pr-media-upload [--repo OWNER/REPO --pr NUMBER] [--update-pr-body] <image-or-video>\n' >&2
  exit 2
}

file_size() {
  if stat -c %s -- "$1" >/dev/null 2>&1; then
    stat -c %s -- "$1"
  else
    stat -f %z -- "$1"
  fi
}

repo=
pr_number=
source_argument=
update_pr_body=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || usage
      repo="$2"
      shift 2
      ;;
    --pr)
      [ "$#" -ge 2 ] || usage
      pr_number="$2"
      shift 2
      ;;
    --update-pr-body)
      update_pr_body=1
      shift
      ;;
    --)
      shift
      [ "$#" -eq 1 ] || usage
      source_argument="$1"
      shift
      ;;
    -*)
      usage
      ;;
    *)
      [ -z "$source_argument" ] || usage
      source_argument="$1"
      shift
      ;;
  esac
done

[ -n "$source_argument" ] || usage

if [ "$update_pr_body" = 1 ] && [ -z "$repo" ] && [ -z "$pr_number" ]; then
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  pr_number="$(gh pr view --json number --jq .number 2>/dev/null || true)"
  if [ -z "$repo" ] || [ -z "$pr_number" ]; then
    printf 'Could not detect the current GitHub repository and pull request.\n' >&2
    exit 2
  fi
fi

if { [ -n "$repo" ] && [ -z "$pr_number" ]; } ||
  { [ -z "$repo" ] && [ -n "$pr_number" ]; }; then
  printf -- '--repo and --pr must be provided together.\n' >&2
  exit 2
fi
if [ -n "$repo" ] &&
  { ! [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
    ! [[ "$pr_number" =~ ^[1-9][0-9]*$ ]]; }; then
  printf 'Invalid GitHub repository or PR number.\n' >&2
  exit 2
fi

source_path="$(realpath -- "$source_argument")"
[ -f "$source_path" ] || usage

media_root="${PR_MEDIA_ROOT:-/srv/pr-media}"
base_url="${PR_MEDIA_BASE_URL:?Set PR_MEDIA_BASE_URL to the public media URL}"
base_url="${base_url%/}"
image_limit="${PR_MEDIA_MAX_IMAGE_BYTES:-52428800}"
video_limit="${PR_MEDIA_MAX_VIDEO_BYTES:-104857600}"
pruner="${PR_MEDIA_PRUNE_COMMAND:-pr-media-prune}"
optimizer="${PR_MEDIA_OPTIMIZE_COMMAND:-pr-media-optimize}"
body_updater="${PR_MEDIA_BODY_COMMAND:-pr-media-add-to-pr}"
gif_preview_seconds="${PR_MEDIA_GIF_PREVIEW_SECONDS:-10}"

filename="$(basename -- "$source_path")"
extension="${filename##*.}"
extension="$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')"
mime_type="$(file --brief --mime-type -- "$source_path")"

case "$mime_type:$extension" in
  image/gif:gif | image/jpeg:jpg | image/jpeg:jpeg | image/png:png | image/webp:webp)
    is_video=0
    limit="$image_limit"
    markdown_prefix='![PR preview]('
    markdown_suffix=')'
    ;;
  video/mp4:mp4 | video/webm:webm)
    is_video=1
    limit="$video_limit"
    markdown_prefix='[PR demo video]('
    markdown_suffix=')'
    ;;
  *)
    printf 'Unsupported media type or mismatched extension: %s (.%s)\n' \
      "$mime_type" "$extension" >&2
    exit 1
    ;;
esac

size="$(file_size "$source_path")"
if [ "$size" -gt "$limit" ]; then
  printf 'Media is %s bytes; the limit for .%s files is %s bytes.\n' \
    "$size" "$extension" "$limit" >&2
  exit 1
fi

temporary=
fallback_lock=
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/pr-media-upload.XXXXXX")"

cleanup() {
  [ -z "$temporary" ] || rm -f -- "$temporary"
  rm -rf -- "$temporary_dir"
  [ -z "$fallback_lock" ] || rmdir -- "$fallback_lock" 2>/dev/null || true
}
trap cleanup EXIT

optimized_path="$source_path"
if [ "${PR_MEDIA_OPTIMIZE:-1}" = 1 ]; then
  optimized_path="$("$optimizer" "$source_path" "$temporary_dir/media")"
  extension="${optimized_path##*.}"
fi

size="$(file_size "$optimized_path")"
if [ "$size" -gt "$limit" ]; then
  printf 'Optimized media is %s bytes; the limit is %s bytes.\n' \
    "$size" "$limit" >&2
  exit 1
fi

digest="$(sha256sum -- "$optimized_path" | awk '{print $1}')"
prefix="${digest:0:2}"
relative_path="$prefix/$digest.$extension"
destination_dir="$media_root/$prefix"
destination="$media_root/$relative_path"
url="$base_url/$relative_path"

preview_path=
preview_digest=
preview_relative_path=
preview_destination_dir=
preview_destination=
preview_url=
if [ "$is_video" = 1 ] && [ -n "$repo" ]; then
  duration="$(
    ffprobe -v error \
      -show_entries format=duration \
      -of default=noprint_wrappers=1:nokey=1 \
      "$optimized_path" 2>/dev/null || true
  )"
  if awk -v duration="$duration" -v limit="$gif_preview_seconds" \
    'BEGIN { exit !(duration > 0 && duration <= limit) }'; then
    preview_path="$temporary_dir/video-preview.gif"
    if ! ffmpeg -hide_banner -loglevel error -y \
      -i "$optimized_path" \
      -map_metadata -1 \
      -filter_complex \
      "[0:v]fps=10,scale='min(800,iw)':-2:flags=lanczos,split[gif][palette_source];[palette_source]palettegen=stats_mode=diff[palette];[gif][palette]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle" \
      -loop 0 \
      "$preview_path"; then
      printf 'Could not generate a GIF preview; publishing the video only.\n' >&2
      preview_path=
    elif [ "$(file_size "$preview_path")" -gt "$image_limit" ]; then
      printf 'GIF preview exceeds the image limit; publishing the video only.\n' >&2
      rm -f -- "$preview_path"
      preview_path=
    else
      preview_digest="$(sha256sum -- "$preview_path" | awk '{print $1}')"
      preview_prefix="${preview_digest:0:2}"
      preview_relative_path="$preview_prefix/$preview_digest.gif"
      preview_destination_dir="$media_root/$preview_prefix"
      preview_destination="$media_root/$preview_relative_path"
      preview_url="$base_url/$preview_relative_path"
    fi
  fi
fi

install -d -m 0755 "$media_root"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$media_root/.upload.lock"
  flock 9
else
  fallback_lock="$media_root/.upload.lock.d"
  if ! mkdir -- "$fallback_lock"; then
    printf 'Another media upload is in progress.\n' >&2
    exit 1
  fi
fi

if command -v "$pruner" >/dev/null 2>&1; then
  PR_MEDIA_LOCK_HELD=1 "$pruner"
fi

if [ ! -f "$destination" ]; then
  install -d -m 0755 "$destination_dir"
  temporary="$(mktemp "$destination_dir/.upload.XXXXXX")"
  install -m 0644 -- "$optimized_path" "$temporary"
  mv -- "$temporary" "$destination"
  temporary=
fi

if [ -n "$preview_path" ] && [ ! -f "$preview_destination" ]; then
  install -d -m 0755 "$preview_destination_dir"
  temporary="$(mktemp "$preview_destination_dir/.upload.XXXXXX")"
  install -m 0644 -- "$preview_path" "$temporary"
  mv -- "$temporary" "$preview_destination"
  temporary=
fi

if [ -n "$repo" ]; then
  repo_owner="${repo%%/*}"
  repo_name="${repo#*/}"
  reference_dir="$media_root/.refs/$digest/$repo_owner/$repo_name"
  install -d -m 0755 "$reference_dir"
  install -m 0644 /dev/null "$reference_dir/$pr_number"
  if [ -n "$preview_digest" ]; then
    preview_reference_dir="$media_root/.refs/$preview_digest/$repo_owner/$repo_name"
    install -d -m 0755 "$preview_reference_dir"
    install -m 0644 /dev/null "$preview_reference_dir/$pr_number"
  fi
fi

if command -v "$pruner" >/dev/null 2>&1; then
  PR_MEDIA_LOCK_HELD=1 "$pruner"
fi

markdown="$markdown_prefix$url$markdown_suffix"
if [ -n "$preview_url" ]; then
  markdown="![PR video preview]($preview_url)<br>$markdown"
fi
if [ "$update_pr_body" = 1 ]; then
  "$body_updater" --repo "$repo" --pr "$pr_number" "$markdown"
fi

printf '%s\n' "$markdown"
